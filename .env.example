# Local Postgres (docker run --name prelude_postgres, see README/infra notes)
DATABASE_URL=postgresql://prelude:prelude_dev_local@localhost:5434/prelude_dev

# Object storage: local filesystem for dev. file_ref is an abstracted pointer
# (e.g. local://<path>) so swapping to a real S3-compatible bucket for
# staging/production is a config change, not a code change.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_PATH=./apps/api/.data/documents

# OCR (M2). OCR_PROVIDER selects the adapter in apps/api/src/services/ocr/:
# 'azure_doc_intelligence' | 'google_document_ai'. Only the selected
# provider's credentials below are required at runtime.
OCR_PROVIDER=
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# Service account key, as its raw JSON content (not a file path).
GOOGLE_DOCUMENT_AI_CREDENTIALS_JSON=

# LLM extraction (M2). EXTRACTION_PROVIDER selects the adapter in
# apps/api/src/services/extraction/: currently only 'anthropic'.
EXTRACTION_PROVIDER=
LLM_API_KEY=

# Web app (apps/web): API base URL the browser calls. Served to the client at
# runtime via /config.js; only PUBLIC_-prefixed values are exposed this way.
PUBLIC_API_URL=http://localhost:3001
