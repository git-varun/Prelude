# Local Postgres (docker run --name opd_postgres, see README/infra notes)
DATABASE_URL=postgresql://opd:opd_dev_local@localhost:5434/opd_dev

# Object storage: local filesystem for dev. file_ref is an abstracted pointer
# (e.g. local://<path>) so swapping to a real S3-compatible bucket for
# staging/production is a config change, not a code change.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_PATH=./apps/api/.data/documents

# OCR + LLM extraction — not needed until M2
OCR_API_KEY=
LLM_API_KEY=
