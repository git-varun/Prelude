# Local Postgres (docker run --name prelude_postgres, see README/infra notes)
DATABASE_URL=postgresql://prelude:prelude_dev_local@localhost:5434/prelude_dev

# Object storage: local filesystem for dev. file_ref is an abstracted pointer
# (e.g. local://<path>) so swapping to a real S3-compatible bucket for
# staging/production is a config change, not a code change.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_PATH=./apps/api/.data/documents

# OCR (M2). OCR_PROVIDER selects the adapter in apps/api/src/services/ocr/:
# 'azure_doc_intelligence' | 'google_document_ai'. Only the selected
# provider's credentials below are required at runtime.
OCR_PROVIDER=
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# Service account key, as its raw JSON content (not a file path).
GOOGLE_DOCUMENT_AI_CREDENTIALS_JSON=

# LLM extraction (M2). EXTRACTION_PROVIDER selects the adapter in
# apps/api/src/services/extraction/: 'bedrock' (India, recommended), 'anthropic', or 'gemini' (pilot-only).
# bedrock: Claude via the India inference profile; AWS_REGION must be ap-south-1 or ap-south-2 and
# EXTRACTION_MODEL must start with in.anthropic. (enforced at startup). No API key: credentials come from the
# default AWS chain (your local profile in dev, the instance role in prod). See docs/bedrock-india-rollout.md.
EXTRACTION_PROVIDER=
# AWS_REGION=ap-south-1
# EXTRACTION_MODEL=in.anthropic.claude-sonnet-5
# Only for EXTRACTION_PROVIDER=anthropic (direct Anthropic API; not India-resident):
LLM_API_KEY=
# Pilot-testing only, never real patient data: EXTRACTION_PROVIDER=gemini + GEMINI_API_KEY + GEMINI_PILOT_TESTING_ONLY=true.
# Rule-based extraction (docs/extraction-pipeline-status.md). Unset or 'llm' = LLM
# extraction only (default). 'deterministic' parses text-layer PDFs with rules and
# falls back to the LLM; do NOT enable in production until the blockers listed in
# docs/extraction-pipeline-status.md section 4 are closed. Migration 009 must be
# applied before running this code against any database, in any mode.
# EXTRACTION_MODE=llm

# Dictation audio pilot (M3-13, AM-02). The id of the ONE oncologist account that may record and play
# their own dictated visit notes. The pilot is a single account; a comma-separated list is accepted but
# should not be used. Unset = the feature is off for everyone (staff never see it either way).
# DICTATION_PILOT_USER_ID=

# Web app (apps/web): API base URL the browser calls. Served to the client at
# runtime via /config.js; only PUBLIC_-prefixed values are exposed this way.
PUBLIC_API_URL=http://localhost:3001
