# Copy to .env at the repo root on the server. Never commit the real file.

DOMAIN=                      # e.g. 32-237-1-160.sslip.io (your instance's Elastic IP, dashes not dots)
POSTGRES_PASSWORD=           # strong random value, generate once and keep it

OCR_PROVIDER=azure_doc_intelligence
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=

# Bedrock, India-only inference profile (patient text stays in ap-south-1/ap-south-2). No LLM_API_KEY: the
# EC2 instance role supplies credentials. Startup fails unless AWS_REGION is an India region and EXTRACTION_MODEL
# starts with in.anthropic. See docs/bedrock-india-rollout.md.
EXTRACTION_PROVIDER=bedrock
AWS_REGION=ap-south-1
EXTRACTION_MODEL=in.anthropic.claude-sonnet-5
# Leave unset (= 'llm') in production; see docs/extraction-pipeline-status.md section 4.
# EXTRACTION_MODE=llm

# PILOT-TESTING ONLY (not India-resident): switch EXTRACTION_PROVIDER to gemini + set these two
# to pipe-test the flow against YOUR OWN documents only. Never for real
# patient data -- see the Decisions Log. Switch EXTRACTION_PROVIDER back
# to bedrock before any real patient use.
# GEMINI_API_KEY=
# GEMINI_PILOT_TESTING_ONLY=true
